<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>Zirve.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Zirve.Api\Zirve.Api.csproj" />
    <ProjectReference Include="..\..\src\Zirve.Runner\Zirve.Runner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- Testlerin çoğu gerçek derleyici ve alt süreçlerle çalışır; süre sınırı içeren testler işlemci
         yarışından etkilenmesin diye test sınıfları paralel koşturulmaz (bkz. xunit.runner.json). -->
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
