# docker compose için ortam değişkenleri. Bu dosyayı .env adıyla kopyalayın ve değerleri değiştirin.
# .env dosyası git'e EKLENMEZ.

# PostgreSQL parolası (uzun ve rastgele bir değer kullanın).
POSTGRES_PASSWORD=degistirin-uzun-rastgele-bir-parola

# API ile Runner arasındaki paylaşılan anahtar (ör. `openssl rand -hex 32`).
RUNNER_API_KEY=degistirin-uzun-rastgele-bir-anahtar

# Sitenin yayımlanacağı ana makine portu.
WEB_PORT=8080

# Oturum çerezlerinde Secure bayrağı. HTTPS arkasında her zaman true olmalıdır.
REQUIRE_SECURE_COOKIES=true
