{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Runner": {
    "ApiKey": "",
    "MaxConcurrency": 0,
    "QueueTimeoutSeconds": 15,
    "TestsTimeoutSeconds": 10,
    "ScriptTimeoutSeconds": 8,
    "PerTestTimeoutMs": 3000,
    "MemoryLimitMb": 256,
    "MaxOutputBytes": 1000000,
    "MaxCodeLength": 50000,
    "MaxTests": 200,
    "DotnetPath": "dotnet",
    "NodePath": "node",
    "WorkDirectory": "",
    "EnforceCSharpApiRestrictions": true,
    "UseNodePermissionModel": true
  }
}
