{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": false,
    "SyncContentOnStartup": true
  },
  "Content": {
    "Path": ""
  },
  "Runner": {
    "BaseUrl": "http://localhost:5081",
    "ApiKey": "",
    "TimeoutSeconds": 60
  },
  "Auth": {
    "RequireSecureCookies": true,
    "SessionDays": 14
  },
  "DataProtection": {
    "KeysPath": ""
  },
  "ForwardedHeaders": {
    "Enabled": false
  },
  "RateLimiting": {
    "GlobalPerMinute": 600,
    "AuthPerMinute": 10,
    "ExecutePerMinute": 30
  }
}
